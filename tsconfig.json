{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@dsh-runtime-client-bundle": ["./node_modules/@deepseek-ai/dsh-client-runtime/lib/client.js"]
    }
  },
  "include": ["src", "tests"]
}
