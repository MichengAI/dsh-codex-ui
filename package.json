{
  "name": "@michengai/dsh-codex-ui",
  "version": "0.2.101",
  "description": "以 Codex 风格重构 DSH Web 侧栏的独立客户端插件",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichengAI/dsh-codex-ui.git"
  },
  "bugs": {
    "url": "https://github.com/MichengAI/dsh-codex-ui/issues"
  },
  "homepage": "https://github.com/MichengAI/dsh-codex-ui#readme",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && vitest run && tsdown && node tests/run-assertions.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.0-rc.5 <0.2.0",
    "@michengai/dsh-agency-agents": ">=0.1.3 <0.2.0",
    "@michengai/dsh-skills-manager": ">=0.1.7 <0.2.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@michengai/dsh-agency-agents": {
      "optional": true
    },
    "@michengai/dsh-skills-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-test-runtime": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-workspace": "0.1.2-alpha.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "~18.3.1",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
